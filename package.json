{
  "name": "lhote",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:vite": "vite --port 5173 --strictPort",
    "build": "vite build && node scripts/gen-feed.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/crimson-pro": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lottie-web": "^5.12.2"
  }
}
