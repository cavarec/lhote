/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Le service worker et le manifeste doivent toujours être revalidés : une mise à jour
# du jeu ne doit pas attendre l'expiration d'un cache.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/index.html
  Cache-Control: no-cache
/nouveautes.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/atom+xml; charset=utf-8
# Fichiers à empreinte (nom change à chaque build) : cache longue durée.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
